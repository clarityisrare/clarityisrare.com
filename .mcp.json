{
    "mcpServers": {
        "astro-docs": {
            "type": "http",
            "url": "https://mcp.docs.astro.build/mcp"
        },
        "playwright": {
            "command": "npx",
            "args": ["-y", "@playwright/mcp@0.0.78", "--browser=chrome", "--headless", "--isolated"]
        },
        "chrome-devtools": {
            "command": "npx",
            "args": ["-y", "chrome-devtools-mcp@1.6.0", "--headless", "--isolated"]
        }
    }
}