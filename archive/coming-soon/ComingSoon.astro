---
import { Image } from 'astro:assets';
import { AUTHOR_NAME, SOCIAL_LINKS } from '../consts';
import logoM from '../assets/images/logo-m.png';
---

<main class="mx-auto w-full max-w-[760px] px-6 py-20 text-center max-[760px]:px-4">
	<div class="mb-8 flex justify-center">
		<Image
			src={logoM}
			width={520}
			alt={AUTHOR_NAME}
			class="h-auto w-full max-w-[420px]"
		/>
	</div>
	<h1
		class="mb-5 text-[40px] font-extrabold leading-[1.12] tracking-[-0.02em] text-pretty text-accent"
	>
		Upcoming soon
	</h1>
	<p class="mx-auto mb-8 max-w-[520px] text-[18px] leading-[1.6] text-ink-2">
		This post is on its way. Subscribe to the RSS feed and you'll be notified the
		moment it goes live.
	</p>
	<div class="flex justify-center">
		<a
			href={SOCIAL_LINKS.rss}
			class="inline-flex items-center gap-2 rounded-full bg-accent px-5 py-2.5 text-[14px] font-bold text-white"
		>
			<svg
				width="15"
				height="15"
				viewBox="0 0 24 24"
				fill="currentColor"
				aria-hidden="true"
				><path
					d="M4 11a9 9 0 0 1 9 9h2.5A11.5 11.5 0 0 0 4 8.5V11zm0 4a5 5 0 0 1 5 5h2.5A7.5 7.5 0 0 0 4 12.5V15zm1.75 5a1.75 1.75 0 1 0 0-3.5 1.75 1.75 0 0 0 0 3.5z"
				></path></svg
			>
			Subscribe via RSS
		</a>
	</div>
</main>
