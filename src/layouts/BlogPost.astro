---
import { Image, Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import ReadAloud from '../components/ReadAloud.astro';
import ScrollControls from '../components/ScrollControls.astro';
import { SITE_TITLE } from '../consts';
import { SERIES, type SeriesId } from '../data/series';

type Props = CollectionEntry<'blog'>['data'];

const {
	title,
	subtitle,
	description,
	series,
	tags = [],
	minutes,
	publishedOn,
	pubDate,
	updatedDate,
	heroImage,
	audio,
} = Astro.props;

const cat = SERIES[series as SeriesId];
const minutesText = minutes ? `${minutes} min read` : '';
---

<html lang="en">
	<head>
		<BaseHead
			title={`${title} · ${SITE_TITLE}`}
			description={description}
			image={heroImage}
			type="article"
			publishedTime={pubDate.toISOString()}
			modifiedTime={updatedDate?.toISOString()}
			breadcrumbName={title}
		/>
	</head>
	<body>
		<Header />
		<main class="mx-auto w-full max-w-[760px] px-6 py-12 text-left max-[760px]:px-4">
			<a
				href="/blog"
				class="mb-7 inline-block text-[14px] font-bold text-accent-ink-soft"
				>← Back to blog</a
			>

			{
				heroImage && (
					<Picture
						src={heroImage}
						formats={['avif', 'webp']}
						fallbackFormat="jpeg"
						widths={[400, 800, 1200, 1520]}
						sizes="(max-width: 760px) 100vw, 760px"
						quality={58}
						alt=""
						class="mb-8 block w-full rounded-2xl"
					/>
				)
			}

			<div class="mb-3.5 flex items-center gap-3.5">
				<Image
					src={cat.image}
					width={128}
					alt=""
					class="h-16 w-16 shrink-0 rounded-[10px] object-cover"
				/>
				<div class="font-mono text-[12px] text-muted-2">{cat.title}</div>
			</div>

			<h1
				id="post-title"
				class="mb-5 text-[40px] font-extrabold leading-[1.12] tracking-[-0.02em] text-pretty text-accent-ink"
			>
				{title}
			</h1>

			<div class="mb-7 flex flex-wrap items-center gap-2.5">
				{
					publishedOn && (
						<span class="text-[14px] font-semibold text-muted">
							Published on {publishedOn}
						</span>
					)
				}
				{
					minutesText && (
						<span class="text-[14px] font-semibold text-muted">{minutesText}</span>
					)
				}
				{
					tags.map((t) => (
						<span class="rounded-[12px] bg-accent-soft px-[11px] py-1 text-[12px] font-semibold text-accent-ink">
							{t}
						</span>
					))
				}
			</div>

			<ReadAloud audio={audio} />

			{
				subtitle && (
					<h2
						id="post-subtitle"
						class="mb-8 text-[28px] font-extrabold leading-[1.2] tracking-[-0.02em] text-pretty text-accent-ink"
					>
						{subtitle}
					</h2>
				)
			}

			<div id="article-body" class="post-prose"><slot /></div>
		</main>
		<ScrollControls />
		<Footer />
	</body>
</html>
