---
import { type CollectionEntry, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { getAllPosts, getPublishedPosts } from '../../lib/posts';

export async function getStaticPaths() {
	// Production builds only published posts, so a draft's URL 404s until it goes
	// live. Dev builds drafts too, so unreleased posts can still be previewed.
	const posts = import.meta.env.PROD ? await getPublishedPosts() : await getAllPosts();
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}
type Props = { post: CollectionEntry<'blog'> };

const { post } = Astro.props;
const { Content } = await render(post);
---

<BlogPost {...post.data}>
	<Content />
</BlogPost>
