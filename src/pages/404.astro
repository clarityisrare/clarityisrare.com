---
import { getImage } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { AUTHOR_NAME, SITE_TITLE } from '../consts';
import heroWideSrc from '../assets/images/logo-hero.png';
import heroTallSrc from '../assets/images/logo-o-m.png';

// Same hero treatment as the home page: an AVIF ladder with a WebP fallback,
// full-bleed behind a translucent text panel on the right. Desktop uses the wide
// illustration; phones and upright tablets get the portrait one (as on /toolkit).
const wideFormats = await Promise.all(
	(['avif', 'webp'] as const).map(async (format) => ({
		format,
		image: await getImage({
			src: heroWideSrc,
			widths: [640, 960, 1280, 1920, 2400],
			sizes: '100vw',
			format,
			quality: 55,
		}),
	})),
);
const tallFormats = await Promise.all(
	(['avif', 'webp'] as const).map(async (format) => ({
		format,
		image: await getImage({
			src: heroTallSrc,
			widths: [480, 640, 768, 838],
			sizes: '100vw',
			format,
			quality: 55,
		}),
	})),
);
// The <img> fallback is the last entry in each list — WebP, the widely safe format.
const heroTall = tallFormats.at(-1)!.image;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Page not found · ${SITE_TITLE}`}
			description="The page you were looking for doesn't exist or has moved."
		/>
	</head>
	<body>
		<Header />
		<main>
			<section class="home-hero">
				<picture>
					{/* Desktop: the wide illustration as a full-bleed background. */}
					{wideFormats.map((f) => (
						<source
							media="(min-width: 1025px)"
							srcset={f.image.srcSet.attribute}
							sizes="100vw"
							type={`image/${f.format}`}
						/>
					))}
					{/* Phones + upright tablets: the portrait illustration, stacked above
					    the text and sized to fit the screen. */}
					{tallFormats
						.filter((f) => f.format !== 'webp')
						.map((f) => (
							<source
								srcset={f.image.srcSet.attribute}
								sizes="100vw"
								type={`image/${f.format}`}
							/>
						))}
					<img
						class="home-hero-img"
						src={heroTall.src}
						srcset={heroTall.srcSet.attribute}
						sizes="100vw"
						alt={AUTHOR_NAME}
						loading="eager"
						fetchpriority="high"
						decoding="async"
					/>
				</picture>
				<div class="home-text rounded-[18px] bg-white/50 backdrop-blur-[4px]">
					<div class="mb-4 font-mono text-[13px] text-muted-2">404</div>
					<h1
						class="mb-5 text-[40px] font-extrabold leading-[1.12] tracking-[-0.03em] text-pretty text-accent-ink"
					>
						Undocumented behaviour.
					</h1>
					<p class="mb-8 text-[20px] leading-[1.6] text-ink-2">
						The link promised a page. The system delivered a 404. The gap between
						those two is basically this whole blog.
					</p>
					<div class="flex flex-wrap gap-4">
						<a
							href="/"
							class="rounded-full bg-accent px-5 py-2.5 text-[14px] font-bold text-white"
						>
							← Home
						</a>
						<a
							href="/blog"
							class="rounded-full border border-line bg-white/60 px-5 py-2.5 text-[14px] font-bold text-accent-ink"
						>
							Browse the blog
						</a>
					</div>
				</div>
			</section>
		</main>
		<Footer />

		<style>
			.home-hero {
				position: relative;
				width: 100%;
				height: calc(100vh - 85px);
				display: flex;
				align-items: center;
				justify-content: flex-end;
			}
			/* Keep the <picture> wrapper out of the box tree entirely, so the
			   absolute/static positioning below still resolves against .home-hero. */
			.home-hero picture {
				display: contents;
			}
			.home-hero-img {
				position: absolute;
				inset: 0;
				width: 100%;
				height: 100%;
				object-fit: contain;
				object-position: center;
			}
			.home-text {
				position: relative;
				z-index: 1;
				width: 42%;
				margin-right: 4vw;
				padding: 32px 34px;
			}
			/* Phones + upright tablets (incl. iPad): stack the portrait illustration on
			   top, sized to fit the screen, with the text below it. Matches the
			   (min-width: 1025px) switch in the <picture> above, so the portrait art is
			   only ever used in this stacked layout. */
			@media (max-width: 1024px) {
				.home-hero {
					display: block;
					height: auto;
					/* Match the 16px side gutter used on every other page. */
					padding: 0 16px;
				}
				.home-hero-img {
					position: static;
					width: 100%;
					height: auto;
					/* Lower than the home/toolkit heroes (100svh - 130px): on a 404 the
					   message needs to be readable without scrolling, so the art gives up
					   the room instead. */
					max-height: 52svh;
					object-fit: contain;
				}
				.home-text {
					width: auto;
					margin-right: 0;
					padding: 24px 0 8px;
					background: none;
					backdrop-filter: none;
					border-radius: 0;
				}
				.home-text :global(h1) {
					font-size: 34px;
				}
				.home-text :global(p) {
					font-size: 18px;
				}
			}
			@media (max-width: 560px) {
				.home-text :global(h1) {
					font-size: 30px;
				}
				.home-text :global(p) {
					font-size: 17px;
				}
			}
		</style>
	</body>
</html>
