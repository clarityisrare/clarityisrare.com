---
import { getImage } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import ComingSoon from '../components/ComingSoon.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import ScrollControls from '../components/ScrollControls.astro';
import { AUTHOR_NAME, COMING_SOON_MODE, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import heroSrc from '../assets/images/logo-hero.png';
import logoM from '../assets/images/logo-m.png';
import { getRecentPosts } from '../lib/posts';

// In coming-soon mode the landing shows the placeholder; skip the hero work.
const hero = COMING_SOON_MODE
	? null
	: await getImage({
			src: heroSrc,
			widths: [640, 960, 1280, 1672],
			sizes: '100vw',
			format: 'webp',
		});
const recent = COMING_SOON_MODE ? [] : await getRecentPosts(4);
---

<!doctype html>
<html lang="en">
	<head>
		{
			COMING_SOON_MODE ? (
				<BaseHead
					title={`Upcoming soon · ${SITE_TITLE}`}
					description="This post is on its way. Subscribe to the RSS feed and you'll be notified the moment it goes live."
					image={logoM}
				/>
			) : (
				<BaseHead
					title={`${SITE_TITLE} — Requirements Engineering notes`}
					description={SITE_DESCRIPTION}
				/>
			)
		}
	</head>
	<body>
		<Header />
		{COMING_SOON_MODE && <ComingSoon />}
		{!COMING_SOON_MODE && (
		<Fragment>
		<main>
			<section class="home-hero">
				<img
					class="home-hero-img"
					src={hero.src}
					srcset={hero.srcSet.attribute}
					sizes="100vw"
					alt={AUTHOR_NAME}
					loading="eager"
					fetchpriority="high"
					decoding="async"
				/>
				<div
					class="home-text rounded-[18px] bg-white/50 backdrop-blur-[4px]"
				>
					<h1
						class="mb-5 text-[40px] font-extrabold leading-[1.12] tracking-[-0.03em] text-pretty text-accent-ink"
					>
						Hello, I am {AUTHOR_NAME}, your Requirements Engineering blogger.
					</h1>
					<p class="text-[20px] leading-[1.6] text-ink-2">
						I'm a senior requirements engineer who's worked across start-ups,
						SMEs and global players, from process to regulatory. I write about
						making requirements clear enough for people <i>and</i> machines.
					</p>
				</div>
			</section>

			<section class="mx-auto max-w-[1120px] px-8 pt-14 pb-2 max-[760px]:px-4">
				<div class="mb-5 flex items-baseline justify-between">
					<h2 class="text-[24px] font-extrabold text-accent-ink">
						Recent posts
					</h2>
					<a href="/blog" class="text-sm font-bold">All posts →</a>
				</div>
				<div
					class="grid grid-cols-[repeat(auto-fit,minmax(240px,1fr))] gap-4"
				>
					{
						recent.map((r) => (
							<a
								href={r.href}
								class="rounded-2xl border border-line bg-white p-[22px] transition-shadow hover:shadow-[0_10px_30px_-16px_rgba(0,0,0,0.35)]"
							>
								<div class="mb-3 font-mono text-[11px] text-muted-2">
									{r.series.title}
								</div>
								<div class="mb-3.5 text-[18px] font-bold leading-[1.28] text-ink">
									{r.post.data.title}
								</div>
								{r.minutesText && (
									<div class="text-xs text-muted-2">{r.minutesText}</div>
								)}
							</a>
						))
					}
				</div>
			</section>
		</main>
		<ScrollControls />
		</Fragment>
		)}
		<Footer />

		<style>
			.home-hero {
				position: relative;
				width: 100%;
				height: calc(100vh - 85px);
				display: flex;
				align-items: center;
				justify-content: flex-end;
			}
			.home-hero-img {
				position: absolute;
				inset: 0;
				width: 100%;
				height: 100%;
				object-fit: contain;
				object-position: center;
			}
			.home-text {
				position: relative;
				z-index: 1;
				width: 42%;
				margin-right: 4vw;
				padding: 32px 34px;
			}
			@media (max-width: 760px) {
				.home-hero {
					display: block;
					height: auto;
					/* Match the 16px side gutter used on every other page. */
					padding: 0 16px;
				}
				.home-hero-img {
					position: static;
					width: 100%;
					height: auto;
					max-height: calc(100svh - 130px);
					object-fit: contain;
				}
				.home-text {
					width: auto;
					margin-right: 0;
					padding: 24px 0 8px;
					background: none;
					backdrop-filter: none;
					border-radius: 0;
				}
				.home-text :global(h1) {
					font-size: 30px;
				}
				.home-text :global(p) {
					font-size: 17px;
				}
			}
		</style>
	</body>
</html>
