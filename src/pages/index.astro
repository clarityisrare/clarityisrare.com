---
import { getImage } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import ScrollControls from '../components/ScrollControls.astro';
import { AUTHOR_NAME, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import heroSrc from '../assets/images/logo-hero.png';
import { getRecentPosts } from '../lib/posts';

// The hero is the LCP image, so it carries an AVIF ladder with a WebP fallback —
// the art is line work on flat white and compresses hard in both.
const heroFormats = await Promise.all(
	(['avif', 'webp'] as const).map(async (format) => ({
		format,
		image: await getImage({
			src: heroSrc,
			widths: [640, 960, 1280, 1920, 2400],
			sizes: '100vw',
			format,
			quality: 55,
		}),
	})),
);
const hero = heroFormats.at(-1)!.image;
const recent = await getRecentPosts(3);

// Card backgrounds sit behind text at 20% opacity, so a small, heavily
// compressed variant is indistinguishable from the full-size art. Going
// through getImage matters: `series.image.src` would serve the untouched
// original (megabytes) instead.
const recentCards = await Promise.all(
	recent.map(async (r) => ({
		...r,
		bg: (
			await getImage({
				src: r.series.image,
				width: 640,
				format: 'webp',
				quality: 50,
			})
		).src,
	})),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`${SITE_TITLE} — Requirements Engineering notes`}
			description={SITE_DESCRIPTION}
		/>
	</head>
	<body>
		<Header />
		<main>
			<section class="home-hero">
				<picture>
					{heroFormats
						.filter((f) => f.format !== 'webp')
						.map((f) => (
							<source
								srcset={f.image.srcSet.attribute}
								sizes="100vw"
								type={`image/${f.format}`}
							/>
						))}
					<img
						class="home-hero-img"
						src={hero.src}
						srcset={hero.srcSet.attribute}
						sizes="100vw"
						alt={AUTHOR_NAME}
						loading="eager"
						fetchpriority="high"
						decoding="async"
					/>
				</picture>
				<div
					class="home-text rounded-[18px] bg-white/50 backdrop-blur-[4px]"
				>
					<h1
						class="mb-5 text-[40px] font-extrabold leading-[1.12] tracking-[-0.03em] text-pretty text-accent-ink"
					>
						Hello, I am {AUTHOR_NAME}, your Requirements Engineering blogger.
					</h1>
					<p class="text-[20px] leading-[1.6] text-ink-2">
						I'm a senior requirements engineer who's worked across start-ups,
						SMEs and global players, from process to regulatory. I write about
						making requirements clear enough for people <i>and</i> machines.
					</p>
				</div>
			</section>

			<section class="mx-auto max-w-[1120px] px-8 pt-14 pb-2 max-[760px]:px-4">
				<div class="mb-5 flex items-baseline justify-between">
					<h2 class="text-[24px] font-extrabold text-accent-ink">
						Recent posts
					</h2>
					<a href="/blog" class="text-sm font-bold">All posts →</a>
				</div>
				<div
					class="grid grid-cols-[repeat(auto-fit,minmax(320px,1fr))] gap-5"
				>
					{
						recentCards.map((r) => (
							<a
								href={r.href}
								class="relative isolate block overflow-hidden rounded-2xl border border-line bg-white p-7 transition-shadow hover:shadow-[0_10px_30px_-16px_rgba(0,0,0,0.35)]"
							>
								<div
									class="absolute inset-0 -z-10 bg-cover bg-center opacity-20"
									style={`background-image:url(${r.bg})`}
								/>
								<div class="mb-3 font-mono text-[12px] font-extrabold text-accent-ink">
									{r.series.title}
								</div>
								<div class="mb-3.5 text-[18px] font-bold leading-[1.28] text-ink">
									{r.post.data.title}
								</div>
								{r.minutesText && (
									<div class="text-xs text-muted-2">{r.minutesText}</div>
								)}
							</a>
						))
					}
				</div>
			</section>
		</main>
		<ScrollControls />
		<Footer />

		<style>
			.home-hero {
				position: relative;
				width: 100%;
				height: calc(100vh - 85px);
				display: flex;
				align-items: center;
				justify-content: flex-end;
			}
			/* Keep the <picture> wrapper out of the box tree entirely, so the
			   absolute/static positioning below still resolves against .home-hero. */
			.home-hero picture {
				display: contents;
			}
			.home-hero-img {
				position: absolute;
				inset: 0;
				width: 100%;
				height: 100%;
				object-fit: contain;
				object-position: center;
			}
			.home-text {
				position: relative;
				z-index: 1;
				width: 42%;
				margin-right: 4vw;
				padding: 32px 34px;
			}
			@media (max-width: 760px) {
				.home-hero {
					display: block;
					height: auto;
					/* Match the 16px side gutter used on every other page. */
					padding: 0 16px;
				}
				.home-hero-img {
					position: static;
					width: 100%;
					height: auto;
					max-height: calc(100svh - 130px);
					object-fit: contain;
				}
				.home-text {
					width: auto;
					margin-right: 0;
					padding: 24px 0 8px;
					background: none;
					backdrop-filter: none;
					border-radius: 0;
				}
				.home-text :global(h1) {
					font-size: 30px;
				}
				.home-text :global(p) {
					font-size: 17px;
				}
			}
		</style>
	</body>
</html>
