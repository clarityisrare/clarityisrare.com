---
import { AUTHOR_NAME, FOOTER_TAGLINE, SOCIAL_LINKS } from '../consts';
---

<footer class="mt-10 border-t border-line">
	<div
		class="mx-auto flex max-w-[1120px] flex-wrap items-center justify-between gap-3 px-8 py-7 text-[13px] text-accent-ink"
	>
		<span>&copy; {AUTHOR_NAME} · Requirements engineering notes</span>

		<div class="flex items-center gap-[18px]">
			<a
				href={SOCIAL_LINKS.linkedin}
				target="_blank"
				rel="noopener"
				aria-label="LinkedIn"
				class="flex text-inherit"
			>
				<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
					><path
						d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"
					></path></svg
				>
			</a>
			<a
				href={SOCIAL_LINKS.github}
				target="_blank"
				rel="noopener"
				aria-label="GitHub"
				class="flex text-inherit"
			>
				<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
					><path
						d="M12 .3a12 12 0 0 0-3.79 23.4c.6.1.82-.26.82-.58v-2.03c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5.99.1-.78.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.11-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.65 1.66.24 2.88.12 3.18.77.84 1.23 1.91 1.23 3.22 0 4.61-2.8 5.63-5.48 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.22.69.83.57A12 12 0 0 0 12 .3z"
					></path></svg
				>
			</a>
			<a
				href={SOCIAL_LINKS.bluesky}
				target="_blank"
				rel="noopener"
				aria-label="Bluesky"
				class="flex text-inherit"
			>
				<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
					><path
						d="M5.77 3.36C8.36 5.3 11.15 9.25 12 11.36c.85-2.11 3.64-6.05 6.23-8 1.87-1.4 4.9-2.49 4.9.98 0 .69-.4 5.82-.63 6.65-.81 2.9-3.76 3.63-6.38 3.19 4.58.78 5.75 3.36 3.23 5.95-4.78 4.9-6.87-1.23-7.41-2.8-.1-.29-.14-.42-.14-.31 0-.11-.05.02-.14.31-.54 1.57-2.63 7.7-7.41 2.8-2.52-2.59-1.35-5.17 3.23-5.95-2.62.44-5.57-.29-6.38-3.19C.9 10.16.5 5.03.5 4.34c0-3.47 3.03-2.38 4.9-.98z"
					></path></svg
				>
			</a>
			<a href={SOCIAL_LINKS.email} aria-label="Email" class="flex text-inherit">
				<svg
					width="20"
					height="20"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
					><rect x="2.5" y="4.5" width="19" height="15" rx="2"></rect><path d="m3 6 9 7 9-7"
					></path></svg
				>
			</a>
			<a href={SOCIAL_LINKS.rss} aria-label="RSS feed" class="flex text-inherit">
				<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
					><path
						d="M4 11a9 9 0 0 1 9 9h2.5A11.5 11.5 0 0 0 4 8.5V11zm0 4a5 5 0 0 1 5 5h2.5A7.5 7.5 0 0 0 4 12.5V15zm1.75 5a1.75 1.75 0 1 0 0-3.5 1.75 1.75 0 0 0 0 3.5z"
					></path></svg
				>
			</a>
		</div>

		<span class="font-mono">{FOOTER_TAGLINE}</span>
	</div>
</footer>
