---
interface Props {
	n: number;
}
const { n } = Astro.props;
---

<div class="mb-2.5 flex items-start gap-3">
	<span
		class="flex h-[26px] w-[26px] shrink-0 items-center justify-center rounded-full bg-accent-soft text-[14px] font-extrabold leading-none text-accent-ink"
		>{n}</span
	>
	<span class="text-[18px] leading-[1.6] text-ink-2"><slot /></span>
</div>
