---
interface Props {
	n: number;
	lead?: string;
}
const { n, lead } = Astro.props;
---

<div class="mb-4 flex items-start gap-3.5">
	<span
		class="flex h-[30px] w-[30px] shrink-0 items-center justify-center rounded-full bg-accent text-[15px] font-extrabold leading-none text-white"
		>{n}</span
	>
	<span class="text-[18px] leading-[1.6] text-ink-2"
		>{lead && <span class="font-extrabold text-ink">{lead} </span>}<slot /></span
	>
</div>
