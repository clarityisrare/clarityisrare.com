---
import { Image } from 'astro:assets';
import logo from '../assets/images/logo-wordmark.png';
import { AUTHOR_NAME } from '../consts';

const path = Astro.url.pathname;
const isActive = (key: 'home' | 'blog' | 'about') => {
	if (key === 'home') return path === '/' || path === '';
	if (key === 'blog') return path.startsWith('/blog');
	return path.startsWith('/about');
};

// Desktop nav pill styles.
const base =
	'rounded-[20px] px-3.5 py-2 text-[15px] font-semibold text-accent-ink transition-colors';
const active =
	'rounded-[20px] bg-accent px-4 py-2 text-[15px] font-semibold text-white hover:text-white';

const links = [
	{ href: '/', label: 'Home', key: 'home' },
	{ href: '/blog', label: 'Blog', key: 'blog' },
	{ href: '/about', label: 'About', key: 'about' },
] as const;

// Items that live in the mobile hamburger menu (Blog stays in the bar).
const menuLinks = [
	{ href: '/', label: 'Home', key: 'home' },
	{ href: '/about', label: 'About', key: 'about' },
	{ href: '/blog', label: 'Search', key: null },
] as const;
---

<header
	class="sticky top-0 z-20 border-b border-line bg-white/85 backdrop-blur-[10px]"
>
	<div
		class="relative mx-auto flex max-w-[1120px] items-center justify-between px-8 py-2 max-[760px]:px-4"
	>
		<a href="/" class="flex items-center gap-2.5" aria-label="Home">
			<Image
				src={logo}
				width={70}
				densities={[2]}
				alt=""
				class="h-[60px] w-auto object-contain"
			/>
			<span
				class="text-[18px] font-extrabold tracking-[-0.02em] text-accent-ink"
				>{AUTHOR_NAME}</span
			>
		</a>

		<!-- Desktop nav -->
		<nav class="hidden items-center gap-1.5 sm:flex">
			{
				links.map((l) => (
					<a href={l.href} class={isActive(l.key) ? active : base}>
						{l.label}
					</a>
				))
			}
			<a
				href="/blog"
				class="ml-1.5 flex items-center gap-2 rounded-[20px] bg-accent-soft px-3.5 py-2 text-sm font-semibold text-accent-ink"
				aria-label="Search posts"
			>
				<span
					class="inline-block h-3 w-3 shrink-0 rounded-full border-2 border-current"
				></span>
				<span>Search</span>
			</a>
		</nav>

		<!-- Mobile nav: Blog link + hamburger -->
		<div class="flex items-center gap-1.5 sm:hidden">
			<a href="/blog" class={isActive('blog') ? active : base}>Blog</a>
			<button
				id="menu-toggle"
				type="button"
				class="flex h-10 w-10 items-center justify-center rounded-[14px] text-accent-ink"
				aria-label="Menu"
				aria-controls="mobile-menu"
				aria-expanded="false"
			>
				<svg
					width="24"
					height="24"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2.5"
					stroke-linecap="round"
					aria-hidden="true"
				>
					<path d="M4 7h16M4 12h16M4 17h16"></path>
				</svg>
			</button>
		</div>

		<!-- Mobile dropdown menu -->
		<div
			id="mobile-menu"
			class="absolute inset-x-0 top-full hidden border-b border-line bg-white/95 backdrop-blur-[10px] sm:hidden"
		>
			<nav class="mx-auto flex max-w-[1120px] flex-col px-4 py-2">
				{
					menuLinks.map((l) => (
						<a
							href={l.href}
							class={`rounded-[12px] px-3 py-3 text-[16px] font-semibold ${
								l.key && isActive(l.key)
									? 'text-accent'
									: 'text-accent-ink'
							}`}
						>
							{l.label}
						</a>
					))
				}
			</nav>
		</div>
	</div>
</header>

<script>
	const toggle = document.getElementById('menu-toggle');
	const menu = document.getElementById('mobile-menu');

	function setOpen(open: boolean) {
		if (!menu || !toggle) return;
		menu.classList.toggle('hidden', !open);
		toggle.setAttribute('aria-expanded', String(open));
	}

	toggle?.addEventListener('click', (e) => {
		e.stopPropagation();
		setOpen(menu?.classList.contains('hidden') ?? false);
	});

	document.addEventListener('click', (e) => {
		if (!menu || menu.classList.contains('hidden')) return;
		const target = e.target as Node;
		if (!menu.contains(target) && !toggle?.contains(target)) setOpen(false);
	});

	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape') setOpen(false);
	});
</script>
