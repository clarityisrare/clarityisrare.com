---
interface Props {
	audio?: string;
}
const { audio } = Astro.props;
const hint = audio
	? 'Plays the recorded audio for this post.'
	: "Uses your browser's built-in voice.";
---

<div>
	<button
		id="read-aloud"
		type="button"
		data-audio={audio ?? ''}
		class="inline-flex cursor-pointer items-center gap-2.5 rounded-[26px] bg-accent px-[22px] py-3 font-bold text-white"
	>
		<span id="read-aloud-label">▶&nbsp;&nbsp;Read aloud</span>
		<span
			id="read-aloud-dot"
			class="hidden h-[9px] w-[9px] rounded-full bg-white [animation:pulse_1s_infinite]"
		></span>
	</button>
	{
		audio && (
			<div id="read-aloud-player" class="mt-3.5 flex max-w-[420px] items-center gap-3">
				<input
					id="read-aloud-seek"
					type="range"
					min="0"
					max="0"
					step="0.1"
					value="0"
					aria-label="Seek within the recording"
					class="h-1.5 w-full cursor-pointer appearance-none rounded-full bg-accent-soft [accent-color:var(--color-accent)]"
				/>
				<span
					id="read-aloud-time"
					class="shrink-0 font-mono text-[12px] tabular-nums text-muted-2"
				>
					0:00 / --:--
				</span>
			</div>
		)
	}
	<div class="mt-2.5 mb-9 text-[13px] text-muted-2">{hint}</div>
</div>

<script>
	const btn = document.getElementById('read-aloud');
	const label = document.getElementById('read-aloud-label');
	const dot = document.getElementById('read-aloud-dot');
	const seek = document.getElementById('read-aloud-seek') as HTMLInputElement | null;
	const time = document.getElementById('read-aloud-time');
	const audioSrc = btn?.dataset.audio || '';

	let audioEl: HTMLAudioElement | null = null;
	let playing = false;
	let scrubbing = false;

	function setPlaying(on: boolean) {
		playing = on;
		if (label) {
			// A recording can be resumed, so it pauses; speech synthesis only stops.
			label.textContent = on
				? audioSrc
					? '❚❚  Pause'
					: '❚❚  Stop'
				: audioSrc && audioEl && audioEl.currentTime > 0
					? '▶  Resume'
					: '▶  Read aloud';
		}
		dot?.classList.toggle('hidden', !on);
	}

	function clock(seconds: number) {
		if (!Number.isFinite(seconds)) return '--:--';
		const m = Math.floor(seconds / 60);
		const s = Math.floor(seconds % 60);
		return `${m}:${String(s).padStart(2, '0')}`;
	}

	function renderProgress() {
		if (!audioEl || !time) return;
		time.textContent = `${clock(audioEl.currentTime)} / ${clock(audioEl.duration)}`;
		if (seek && !scrubbing) seek.value = String(audioEl.currentTime);
	}

	function getAudio() {
		if (!audioEl) {
			audioEl = new Audio(audioSrc);
			// Only the header is fetched up front; the file itself streams on play.
			audioEl.preload = 'metadata';
			audioEl.addEventListener('loadedmetadata', () => {
				if (seek) seek.max = String(audioEl!.duration || 0);
				renderProgress();
			});
			audioEl.addEventListener('timeupdate', renderProgress);
			audioEl.addEventListener('ended', () => {
				audioEl!.currentTime = 0;
				setPlaying(false);
				renderProgress();
			});
			audioEl.addEventListener('error', () => setPlaying(false));
		}
		return audioEl;
	}

	function stop() {
		try {
			window.speechSynthesis?.cancel();
		} catch {}
		try {
			audioEl?.pause();
		} catch {}
		setPlaying(false);
	}

	function gatherText() {
		const parts: string[] = [];
		const title = document.getElementById('post-title');
		if (title?.textContent) parts.push(title.textContent);
		const subtitle = document.getElementById('post-subtitle');
		if (subtitle?.textContent) parts.push(subtitle.textContent);
		const body = document.getElementById('article-body') as HTMLElement | null;
		if (body?.innerText) parts.push(body.innerText);
		return parts.join('. ');
	}

	function speak() {
		const synth = window.speechSynthesis;
		if (!synth) return;
		const u = new SpeechSynthesisUtterance(gatherText());
		u.lang = 'en-US';
		u.rate = 1;
		u.onend = () => setPlaying(false);
		u.onerror = () => setPlaying(false);
		synth.cancel();
		synth.speak(u);
		setPlaying(true);
	}

	btn?.addEventListener('click', () => {
		if (playing) {
			stop();
			return;
		}
		if (audioSrc) {
			getAudio()
				.play()
				.then(() => setPlaying(true))
				.catch(() => setPlaying(false));
		} else {
			speak();
		}
	});

	seek?.addEventListener('pointerdown', () => {
		scrubbing = true;
	});
	seek?.addEventListener('input', () => {
		if (time && audioEl) time.textContent = `${clock(+seek.value)} / ${clock(audioEl.duration)}`;
	});
	seek?.addEventListener('change', () => {
		scrubbing = false;
		getAudio().currentTime = +seek.value;
		renderProgress();
	});

	// Load the duration so the readout is populated before the first play.
	if (audioSrc) getAudio();

	window.addEventListener('beforeunload', stop);
</script>
