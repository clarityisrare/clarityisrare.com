---
// Imported on every page via <BaseHead />, so global.css loads site-wide too.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { Font, getImage } from 'astro:assets';
import FallbackImage from '../assets/images/logo-hero.png';
import LogoSquare from '../assets/images/logo-square.png';
import { AUTHOR_NAME, SITE_TITLE } from '../consts';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	type?: 'website' | 'article';
	/** ISO date string, for articles. */
	publishedTime?: string;
}

const {
	title,
	description,
	image = FallbackImage,
	type = 'website',
	publishedTime,
} = Astro.props;

const site = Astro.site!;
const canonicalURL = new URL(Astro.url.pathname, site);

// Social share image: JPEG (the format every platform renders reliably —
// LinkedIn, Bluesky, X, iMessage, WhatsApp, Slack). Width is capped at 1200 and
// never upscaled, so the declared dimensions below match the real output.
const ogWidth = Math.min(1200, image.width);
const ogHeight = Math.round((ogWidth * image.height) / image.width);
const ogImage = await getImage({
	src: image,
	width: ogWidth,
	format: 'jpeg',
	quality: 80,
});
const ogImageURL = new URL(ogImage.src, site).href;

// Publisher logo for structured data.
const logo = await getImage({ src: LogoSquare, width: 512, height: 512, format: 'png' });
const logoURL = new URL(logo.src, site).href;

const jsonLd =
	type === 'article'
		? {
				'@context': 'https://schema.org',
				'@type': 'BlogPosting',
				headline: title,
				description,
				image: ogImageURL,
				datePublished: publishedTime,
				dateModified: publishedTime,
				author: {
					'@type': 'Person',
					name: AUTHOR_NAME,
					url: new URL('/about/', site).href,
				},
				publisher: {
					'@type': 'Organization',
					name: SITE_TITLE,
					logo: { '@type': 'ImageObject', url: logoURL },
				},
				mainEntityOfPage: canonicalURL.href,
			}
		: {
				'@context': 'https://schema.org',
				'@type': 'WebSite',
				name: SITE_TITLE,
				url: site.href,
				description,
			};
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/png" href="/favicon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', site)}
/>
<meta name="generator" content={Astro.generator} />

<Font cssVariable="--font-manrope" preload />
<Font cssVariable="--font-ibm-mono" />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />

<!-- Open Graph / Facebook / LinkedIn -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:image:secure_url" content={ogImageURL} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content={String(ogWidth)} />
<meta property="og:image:height" content={String(ogHeight)} />
<meta property="og:image:alt" content={title} />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{type === 'article' && <meta property="article:author" content={AUTHOR_NAME} />}

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL} />
<meta name="twitter:image:alt" content={title} />

<!-- Structured data (rich results) -->
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
