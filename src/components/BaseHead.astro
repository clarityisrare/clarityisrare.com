---
// Imported on every page via <BaseHead />, so global.css loads site-wide too.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { Font, getImage } from 'astro:assets';
import FallbackImage from '../assets/images/logo-hero.png';
import LogoSquare from '../assets/images/logo-square.png';
import { AUTHOR_NAME, CLOUDFLARE_ANALYTICS_TOKEN, SITE_TITLE, SOCIAL_LINKS } from '../consts';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	type?: 'website' | 'article';
	/** ISO date string, for articles. */
	publishedTime?: string;
	/** ISO date string of the last update, for articles. */
	modifiedTime?: string;
	/** Plain post title (no brand suffix), used for the breadcrumb trail. */
	breadcrumbName?: string;
}

const {
	title,
	description,
	image = FallbackImage,
	type = 'website',
	publishedTime,
	modifiedTime,
	breadcrumbName,
} = Astro.props;

const site = Astro.site!;
const canonicalURL = new URL(Astro.url.pathname, site);

// Social share image: JPEG (the format every platform renders reliably —
// LinkedIn, Bluesky, X, iMessage, WhatsApp, Slack). Width is capped at 1200 and
// never upscaled, so the declared dimensions below match the real output.
const ogWidth = Math.min(1200, image.width);
const ogHeight = Math.round((ogWidth * image.height) / image.width);
const ogImage = await getImage({
	src: image,
	width: ogWidth,
	format: 'jpeg',
	quality: 80,
});
const ogImageURL = new URL(ogImage.src, site).href;

// Publisher logo for structured data.
const logo = await getImage({ src: LogoSquare, width: 512, height: 512, format: 'png' });
const logoURL = new URL(logo.src, site).href;

// Author identity, reused across schemas. `sameAs` links the persona to its
// off-site profiles so search engines can build a single entity for the author.
const author = {
	'@type': 'Person',
	name: AUTHOR_NAME,
	url: new URL('/about/', site).href,
	sameAs: [SOCIAL_LINKS.linkedin, SOCIAL_LINKS.github, SOCIAL_LINKS.bluesky],
};

const publisher = {
	'@type': 'Organization',
	name: SITE_TITLE,
	url: site.href,
	logo: { '@type': 'ImageObject', url: logoURL, width: 512, height: 512 },
};

const ogImageObject = {
	'@type': 'ImageObject',
	url: ogImageURL,
	width: ogWidth,
	height: ogHeight,
};

const jsonLd =
	type === 'article'
		? {
				'@context': 'https://schema.org',
				'@graph': [
					{
						'@type': 'BlogPosting',
						headline: breadcrumbName ?? title,
						description,
						image: ogImageObject,
						datePublished: publishedTime,
						dateModified: modifiedTime ?? publishedTime,
						author,
						publisher,
						mainEntityOfPage: canonicalURL.href,
					},
					{
						'@type': 'BreadcrumbList',
						itemListElement: [
							{ '@type': 'ListItem', position: 1, name: 'Home', item: site.href },
							{
								'@type': 'ListItem',
								position: 2,
								name: 'Blog',
								item: new URL('/blog/', site).href,
							},
							{
								'@type': 'ListItem',
								position: 3,
								name: breadcrumbName ?? title,
								item: canonicalURL.href,
							},
						],
					},
				],
			}
		: {
				'@context': 'https://schema.org',
				'@type': 'WebSite',
				name: SITE_TITLE,
				url: site.href,
				description,
				publisher,
			};
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/png" href="/favicon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', site)}
/>
<meta name="generator" content={Astro.generator} />

<Font cssVariable="--font-manrope" preload />
<Font cssVariable="--font-ibm-mono" />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />

<!-- Open Graph / Facebook / LinkedIn -->
<meta property="og:type" content={type} />
<meta property="og:locale" content="en_US" />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:image:secure_url" content={ogImageURL} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content={String(ogWidth)} />
<meta property="og:image:height" content={String(ogHeight)} />
<meta property="og:image:alt" content={title} />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{type === 'article' && <meta property="article:author" content={AUTHOR_NAME} />}

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL} />
<meta name="twitter:image:alt" content={title} />

<!-- Structured data (rich results) -->
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<!-- Cloudflare Web Analytics (only when a token is configured in consts.ts) -->
{
	CLOUDFLARE_ANALYTICS_TOKEN && (
		<script
			is:inline
			defer
			src="https://static.cloudflareinsights.com/beacon.min.js"
			data-cf-beacon={`{"token": "${CLOUDFLARE_ANALYTICS_TOKEN}"}`}
		/>
	)
}
